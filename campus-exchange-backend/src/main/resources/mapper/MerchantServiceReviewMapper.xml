<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.campusmarket.exchange.mapper.MerchantServiceReviewMapper">

    <!-- 根据商家ID查询评价列表 -->
    <select id="selectByMerchantId" resultType="org.campusmarket.exchange.entity.MerchantServiceReview">
        SELECT * FROM merchant_service_review
        WHERE merchant_id = #{merchantId}
        ORDER BY create_time DESC
        <if test="limit != null and limit > 0">
            LIMIT #{limit}
        </if>
    </select>
    
</mapper> 